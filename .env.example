# Copy this file to .env and fill in the values.
# .env is gitignored — secrets never land in git.
#
# `teamroom serve` injects every KEY=value pair into process.env at startup.
# Values already set by the shell take precedence — .env only fills in missing keys.

# ---------------------------------------------------------------------------
# Credentials (required for live agent backends)
# ---------------------------------------------------------------------------

# Required for studio-assistant (LM Studio backend).
LM_STUDIO_API_TOKEN=

# Optional: override the LM Studio base URL (default: http://localhost:1234).
# The daemon (host process) reaches LM Studio at localhost; only the container
# uses host.docker.internal to reach back to the host (that's the proxy URL,
# computed automatically — don't set it here).
# LM_STUDIO_BASE_URL=http://localhost:1234

# Optional: override the Ollama base URL (default: http://localhost:11434).
# Similar to LM_STUDIO_BASE_URL — the host-side proxy reaches Ollama at
# localhost; the container reaches the proxy via host.docker.internal.
# OLLAMA_BASE_URL=http://localhost:11434

# For claude-assistant (Anthropic backend). The container uses the Claude
# Code CLI as a subprocess (via @anthropic-ai/claude-agent-sdk) and routes
# its calls through our proxy, which substitutes the real credential.
# Pick ONE:
#   - OAuth (default — uses your Claude Pro/Max subscription): on macOS,
#     just log into Claude Code and the credential is auto-discovered from
#     the Keychain (service "Claude Code-credentials"). On Linux/Windows,
#     ~/.claude/.credentials.json is read. If you'd rather avoid the
#     Keychain prompt, run `claude setup-token` in a separate terminal
#     (it doesn't work from inside Claude Code itself) and paste here:
#         CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#   - API key (fallback for non-subscription / metered billing): set
#     ANTHROPIC_API_KEY from console.anthropic.com.
# If both are set, OAuth wins. See docs/runbooks/anthropic-auth.md.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# OpenAI-compatible hosted provider token (used by provider: openai agents).
OPENAI_TOKEN=
# OPENAI_BASE_URL=https://api.openai.com

# OpenRouter hosted provider token (used by provider: openrouter agents).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# ---------------------------------------------------------------------------
# Daemon tunables (all optional)
# ---------------------------------------------------------------------------

# Minutes of agent inactivity before the session manager closes the
# container's stdin (prompting clean exit). 0 disables the timer.
# TEAMROOM_SESSION_IDLE_MINUTES=30

# Maximum number of mails per thread before the dispatcher rejects new sends
# with thread_cap_exceeded. Acceptance feedback raised the default from 10.
# TEAMROOM_MAX_MAILS_PER_THREAD=40

# Optional codebase mount made available to agent containers at /codebase.
# If unset, the daemon looks for ./codebase relative to the data dir.
# TEAMROOM_CODEBASE_PATH=/abs/path/to/codebase

# Identity used as the CLI channel external-id (channel:cli:<user>) for
# `teamroom chat` and `teamroom send`. Defaults to `os.userInfo().username`.
# TEAMROOM_USER=don
