# Copy this file to .env and fill in the values.
# .env is gitignored — secrets never land in git.

# Required in M1: token for the local LM Studio endpoint.
LM_STUDIO_API_TOKEN=

# Optional overrides. Uncomment to change defaults.
# TEAMROOM_MODEL_BASE_URL=http://host.docker.internal:1234/v1
# TEAMROOM_MODEL=qwen/qwen3.5-9b
