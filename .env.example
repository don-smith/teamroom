# Copy this file to .env and fill in the values.
# .env is gitignored — secrets never land in git.

# Required for studio-assistant (LM Studio backend).
LM_STUDIO_API_TOKEN=

# Optional: override the LM Studio base URL (default: http://localhost:1234).
# The daemon (host process) reaches LM Studio at localhost; only the container
# uses host.docker.internal to reach back to the host (that's the proxy URL,
# computed automatically — don't set it here).
# LM_STUDIO_BASE_URL=http://localhost:1234

# For claude-assistant (Anthropic backend). Pick ONE:
#   - OAuth (preferred): leave both unset and Team Room reads the macOS
#     Keychain (service "Claude Code-credentials") on macOS, or
#     ~/.claude/.credentials.json on Linux/Windows. To avoid Keychain
#     prompts, run `claude setup-token` and paste its output here:
#         CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#   - API key (fallback for non-subscription): set ANTHROPIC_API_KEY.
# If both are set, OAuth wins. See docs/runbooks/anthropic-auth.md.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
