<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.teamroom.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/don/.local/bin/teamroom</string>
        <string>serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/don/projects/teamroom/teamroom</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/don/projects/teamroom/teamroom/data/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/don/projects/teamroom/teamroom/data/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TEAMROOM_USER</key>
        <string>don</string>
    </dict>
</dict>
</plist>